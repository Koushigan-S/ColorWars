rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check if a user is updating their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow user creation and self-updates
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }
    
    // 2. Rooms collection
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      
      allow update: if isAuthenticated() && (
        // Case A: A guest is joining the room.
        (resource.data.guestId == null && request.resource.data.guestId == request.auth.uid) ||
        
        // Case B: Host or Guest is updating the room.
        (resource.data.hostId == request.auth.uid || resource.data.guestId == request.auth.uid)
      );
      
      allow delete: if false;
    }
    
    // 3. Matches (Match History) collection
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.players.red.uid == request.auth.uid ||
        request.resource.data.players.blue.uid == request.auth.uid
      );
      allow update, delete: if false;
    }

    // 4. Invites collection for live match invitations
    match /invites/{inviteId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Chats collection for direct in-game messaging between friends
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
  }
}
