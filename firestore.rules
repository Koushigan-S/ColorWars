rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // 1. Users collection (profile sync, status heartbeat, friend requests, friends array)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // 2. Rooms collection
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // 3. Matches (Match History) collection
    match /matches/{matchId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Invites collection for live match invitations
    match /invites/{inviteId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Chats collection for direct in-game messaging between friends
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
  }
}
